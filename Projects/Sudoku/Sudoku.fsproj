<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ProjectGuid>{894E8EBE-2367-42B4-BAC2-F8FF23C55730}</ProjectGuid>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<TargetPlatformIdentifier>$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))</TargetPlatformIdentifier>
		<ServerGarbageCollection>True</ServerGarbageCollection>
		<TieredPGO>True</TieredPGO>
		<DisableFastUpToDateCheck>True</DisableFastUpToDateCheck>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<PostBuildEvent>dotnet "$(MSBuildProjectDirectory)/../../Nu/Nu.Pipe/bin/$(Configuration)/$(TargetFramework)/Nu.Pipe.dll" "$(MSBuildProjectDirectory)/" "$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/" "$(MSBuildProjectDirectory)/refinement/" "BcCompression" "False"</PostBuildEvent>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCpu'">
		<WarnOn>FS1182</WarnOn>
		<NoWarn>FS0009;FS0052;FS1178;FS3391;FS3536;FS3560</NoWarn>
		<Tailcalls>False</Tailcalls>
		<WarningLevel>5</WarningLevel>
		<DefineConstants>TRACE</DefineConstants>
		<WarningsAsErrors>FS0026;FS0049;FS3239;$(WarningsAsErrors)</WarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCpu'">
		<WarnOn>FS1182</WarnOn>
		<NoWarn>FS0009;FS0052;FS1178;FS3391;FS3536;FS3560</NoWarn>
		<Tailcalls>False</Tailcalls>
		<WarningLevel>5</WarningLevel>
		<DefineConstants>TRACE</DefineConstants>
		<WarningsAsErrors>FS0026;FS0049;FS3239;$(WarningsAsErrors)</WarningsAsErrors>
	</PropertyGroup>

	<Target Name="OverridePublishDir" AfterTargets="AssignTargetPaths">
		<PropertyGroup>
			<PublishDir>$(OutputPath)</PublishDir>
		</PropertyGroup>
	</Target>

    <Target Name="BuildNuPipe" BeforeTargets="BeforeBuild">
        <MSBuild Projects="$(MSBuildProjectDirectory)/../../Nu/Nu.Pipe/Nu.Pipe.fsproj" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" Targets="Restore;Build" />
    </Target>

	<Target Name="AfterCleanNuPipe" AfterTargets="Clean">
		<RemoveDir Directories="refinement" />
		<RemoveDir Directories="$(OutDir)/Assets" />
	</Target>

	<ItemGroup>
		<None Include="Assets\*" />
        <None Include="Assets\*\*" />
		<Compile Include="Simulants.fs" />
		<Compile Include="Assets.fs" />
		<Compile Include="SudokuGrid.fs" />
		<Compile Include="ProgressionTypes.fs" />
		<Compile Include="Events.fs" />
		<Compile Include="SudokuHints.fs" />
		<Compile Include="PuzzleAnalysis.fs" />
		<Compile Include="PuzzleGeneration.fs" />
		<Compile Include="PuzzleCorpus.fs" />
		<Compile Include="PuzzleBank.fs" />
		<Compile Include="ProgressionMap.fs" />
		<Compile Include="Gameplay.fs" />
		<Compile Include="Sudoku.fs" />
		<Compile Include="SudokuPlugin.fs" />
		<Compile Include="Program.fs" />
		<Content Include="AssetGraph.nuag">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Overlayer.nuol">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<None Include="App.config" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="AssimpNet">
			<HintPath>..\..\Nu\Nu.Dependencies\AssimpNet\netstandard2.1\AssimpNet.dll</HintPath>
		</Reference>
        <Reference Include="BulletSharpPInvoke">
            <HintPath>..\..\Nu\Nu.Dependencies\BulletSharpPInvoke\netstandard2.1\BulletSharp.dll</HintPath>
        </Reference>
		<Reference Include="OpenGL.Net">
			<HintPath>..\..\Nu\Nu.Dependencies\OpenGL.NET\lib\netcoreapp2.2\OpenGL.Net.dll</HintPath>
		</Reference>
		<Reference Include="TiledSharp">
			<HintPath>..\..\Nu\Nu.Dependencies\TiledSharp\lib\netstandard2.0\TiledSharp.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Nu\Nu\Nu.fsproj" />
		<ProjectReference Include="..\..\Nu\Nu.Math\Nu.Math.csproj" />
		<ProjectReference Include="..\..\Nu\Nu.Spine\Nu.Spine.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<MacOSVulkanSdk></MacOSVulkanSdk>
	</PropertyGroup>
	<Target Name="CopyMacOSVulkanSdk" BeforeTargets="AssignTargetPaths" Condition="'$(TargetPlatformIdentifier)' == '' And $([System.OperatingSystem]::IsMacOS())">
		<Exec Condition="'$(MacOSVulkanSdk)' == ''" Command="
			if [ -x ~/.bash_profile ]
			then source ~/.bash_profile
			fi
			if [ &quot;$VULKAN_SDK&quot; == &quot;&quot; ]
			then VULKAN_SDK=`ls -d ~/VulkanSDK/* | grep -E &quot;[^/]+/[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$&quot; | sort -V -r | head -n 1`
			fi
			echo &quot;$VULKAN_SDK&quot;" ConsoleToMsBuild="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="MacOSVulkanSdk" />
		</Exec>
		<Error Text="Please install the macOS Vulkan SDK. If installed to a non-default location, override the MacOSVulkanSdk property in this file." Condition="!$([System.IO.Directory]::Exists($(MacOSVulkanSdk)))" />
		<ItemGroup>
			<MacOSVulkanSdkDylib Include="$(MacOSVulkanSdk)/macOS/lib/*.dylib" />
			<MacOSVulkanSdkIcdJson Include="$(MacOSVulkanSdk)/macOS/share/**/*_icd.json" />
		</ItemGroup>
		<Error Condition="'@(MacOSVulkanSdkDylib)'==''" Text="No macOS Vulkan SDK dylibs were found at '$(MacOSVulkanSdk)/macOS/lib/*.dylib'. Ensure MacOSVulkanSdk points to a valid Vulkan SDK installation." />
		<Exec Command="mkdir -p &quot;$(OutDir)%(MacOSVulkanSdkDylib.RecursiveDir)&quot; &amp;&amp; ln -sfn &quot;%(MacOSVulkanSdkDylib.Identity)&quot; &quot;$(OutDir)%(MacOSVulkanSdkDylib.RecursiveDir)%(MacOSVulkanSdkDylib.Filename)%(MacOSVulkanSdkDylib.Extension)&quot;" />
		<Copy SourceFiles="@(MacOSVulkanSdkIcdJson)" DestinationFiles="@(MacOSVulkanSdkIcdJson->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
		<ItemGroup>
			<OutIcdJsonFile Include="$(OutDir)/vulkan/icd.d/*_icd.json" />
		</ItemGroup>
		<WriteLinesToFile File="%(OutIcdJsonFile.Identity)" Lines="$([System.IO.File]::ReadAllText('%(OutIcdJsonFile.Identity)').Replace('../../../lib/','../../'))" Overwrite="true" />
	</Target>

</Project>
