#version 450 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 1, binding = 0) readonly buffer GridBuffer { uint gridWords[]; };
layout(std430, set = 1, binding = 1) writeonly buffer SplatBuffer { uint splats[]; };
layout(std430, set = 1, binding = 3) buffer IndirectBuffer { uint command[]; };

struct VoxelGridInfoStruct
{
    vec4 gridSize;
    vec4 counts;
};

layout(set = 1, binding = 4) uniform GridInfoUniform { VoxelGridInfoStruct gridInfo; };

uint readGrid(uint linearIndex)
{
    uint indexBits = uint(gridInfo.gridSize.w);
    uint indicesPerWord = 32u / indexBits;
    uint mask = indexBits == 8u ? 0xFFu : 0xFFFFu;
    uint shift = (linearIndex % indicesPerWord) * indexBits;
    return (gridWords[linearIndex / indicesPerWord] >> shift) & mask;
}

bool occupied(ivec3 coord)
{
    ivec3 size = ivec3(gridInfo.gridSize.xyz);
    if (any(lessThan(coord, ivec3(0))) || any(greaterThanEqual(coord, size)))
        return false;
    uint linearIndex = uint(coord.x + size.x * (coord.y + size.y * coord.z));
    return readGrid(linearIndex) != 0u;
}

uint reserveSplat(uint capacity)
{
    uint current = atomicAdd(command[1], 0u);
    while (current < capacity)
    {
        uint previous = atomicCompSwap(command[1], current, current + 1u);
        if (previous == current)
            return current;
        current = previous;
    }
    return capacity;
}

void main()
{
    uint linearIndex = gl_GlobalInvocationID.x;
    uint volume = uint(gridInfo.counts.x);
    if (linearIndex >= volume || readGrid(linearIndex) == 0u)
        return;

    ivec3 size = ivec3(gridInfo.gridSize.xyz);
    int x = int(linearIndex % uint(size.x));
    uint yz = linearIndex / uint(size.x);
    int y = int(yz % uint(size.y));
    int z = int(yz / uint(size.y));
    ivec3 coord = ivec3(x, y, z);

    bool exposed =
        !occupied(coord + ivec3( 1, 0, 0)) ||
        !occupied(coord + ivec3(-1, 0, 0)) ||
        !occupied(coord + ivec3( 0, 1, 0)) ||
        !occupied(coord + ivec3( 0,-1, 0)) ||
        !occupied(coord + ivec3( 0, 0, 1)) ||
        !occupied(coord + ivec3( 0, 0,-1));
    if (!exposed)
        return;

    uint capacity = uint(gridInfo.counts.y);
    uint outputIndex = reserveSplat(capacity);
    if (outputIndex < capacity)
        splats[outputIndex] = linearIndex;
}
